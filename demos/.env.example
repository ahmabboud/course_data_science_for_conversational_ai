# From the demos folder, copy this file to .env, then fill in the key:
# cp .env.example .env
# This is the instructor's own key for running demo notebooks, separate from
# any team's own .env in their project repository.
#
# Free, no card required. Get one at https://aistudio.google.com/apikey,
# see demos/README.md for the exact steps.
GOOGLE_API_KEY=

# Required only to open the Module 2 graph in LangSmith Studio. Create a free
# key at https://smith.langchain.com/settings. Keep tracing off for this local
# instructor demo unless you deliberately want runs stored in LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Only needed for Module 2's LangGraph Studio demo (langgraph dev), not for
# Module 1's notebook, not for raw_loop.py, not for graph.py's own quick
# check. Studio is a hosted page that connects to your local server, so it
# needs its own credential to authenticate that connection. Free, no card
# required (Developer plan, 5,000 traces/month included). Sign up and
# create a key at https://smith.langchain.com/settings, see
# demos/module-02/README.md for the exact steps.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
