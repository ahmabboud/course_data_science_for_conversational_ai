# From the demos folder, copy this file to .env, then fill in the key:
# cp .env.example .env
# This is the instructor's own key for running demo notebooks, separate from
# any team's own .env in their project repository.
#
# Free, no card required. Get one at https://aistudio.google.com/apikey,
# see demos/README.md for the exact steps.
GOOGLE_API_KEY=

# MODEL FOR EVERY DEMO. All demos run on the cheapest Gemini text model that
# works for them: gemini-3.1-flash-lite (USD 0.25 in / 1.50 out per million
# tokens on 30 September 2026, free tier available). The demos only show an
# idea, they do not need a strong model. gemini-2.5-flash-lite is cheaper but
# the API refuses it for new users (404). If a demo stalls or returns a 429,
# check the limits at https://ai.dev/rate-limit before changing anything.
#
# Modules 1-2's demos call Gemini's Interactions API directly with a bare
# model name (no "models/" prefix).
GENERATION_MODEL=gemini-3.1-flash-lite

# Module 3 uses a single structured assessment request per question so its
# complete three-question run fits the free-tier request budget.
M03_GENERATION_MODEL=gemini-3.1-flash-lite

# Required only to open the Module 2 graph in LangSmith Studio. Create a free
# key at https://smith.langchain.com/settings. Keep tracing off for this local
# instructor demo unless you deliberately want runs stored in LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Module 4's Mem0 demo only. Mem0's own Gemini integration expects
# "models/"-prefixed names, a different convention from GENERATION_MODEL
# above, that is why these are separate variables rather than one reused.
# The defaults are valid Gemini models; override only when deliberately
# testing a different supported model.
MEM0_GENERATION_MODEL=models/gemini-3.1-flash-lite
MEM0_EMBEDDING_MODEL=models/gemini-embedding-001

# Module 5's evaluation harness (its toy agent's reply and judge calls),
# same bare-name Interactions-API convention as GENERATION_MODEL above,
# kept separate so this module's demo can be pinned or swapped on its own.
M05_GENERATION_MODEL=gemini-3.1-flash-lite
